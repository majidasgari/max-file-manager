{
  "name": "max-file-manager",
  "version": "1.0.8",
  "desktopName": "max-file-manager.desktop",
  "description": "Dual-pane file manager for KDE and Windows (Directory Opus class), Electron + TypeScript",
  "license": "MIT",
  "author": "Majid Asgari <majidasgari@users.noreply.github.com>",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && node scripts/build-wine-hook.mjs && node scripts/build-wayland-clip.mjs",
    "start": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "node --test src/main/*.test.ts src/shared/*.test.ts src/renderer/src/*.test.ts",
    "fix:icons-case": "node scripts/fix-case-collisions.mjs",
    "dist:linux": "npm run build && electron-builder --linux AppImage deb",
    "dist:win": "npm run build && electron-builder --win nsis",
    "dist:mac": "npm run build && electron-builder --mac dmg zip"
  },
  "devDependencies": {
    "@milkdown/crepe": "^7.22.2",
    "@milkdown/kit": "^7.22.2",
    "@milkdown/prose": "^7.22.2",
    "@milkdown/utils": "^7.22.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ssh2": "^1.15.6",
    "@vitejs/plugin-react": "^5.0.0",
    "dompurify": "^3.4.17",
    "electron": "^45.3.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^4.0.0",
    "fflate": "^0.8.3",
    "highlight.js": "^11.12.0",
    "linkedom": "^0.18.15",
    "marked": "^18.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.9.0",
    "vazirmatn": "^33.0.3",
    "vite": "^7.0.0"
  },
  "overrides": {
    "prosemirror-model": "1.25.11",
    "dbus-next": {
      "usocket": "^1.1.0",
      "xml2js": "^0.6.2"
    }
  },
  "dependencies": {
    "age-encryption": "^0.3.1",
    "basic-ftp": "^6.2.6",
    "dbus-next": "^0.10.2",
    "ssh2": "^1.17.0"
  }
}
